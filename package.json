{
  "name": "sssf-capacitor-assets",
  "version": "4.1.5",
  "packageManager": "pnpm@11.13.1",
  "description": "Generate icon and splash screen images for Capacitor apps",
  "homepage": "https://github.com/sssf-code/capacitor-assets",
  "author": "Ionic Team <hi@ionicframework.com>",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "engines": {
    "node": ">=22.12.0"
  },
  "bin": {
    "capacitor-assets": "./bin/capacitor-assets"
  },
  "scripts": {
    "prepare": "husky",
    "build": "tsc",
    "watch": "tsc -w",
    "test": "vitest run",
    "lint": "oxlint && pnpm run prettier --check",
    "fmt": "pnpm run prettier --write",
    "prettier": "prettier **/*.ts",
    "prepublishOnly": "pnpm run build"
  },
  "prettier": "@ionic/prettier-config",
  "files": [
    "bin",
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sssf-code/capacitor-assets.git"
  },
  "bugs": {
    "url": "https://github.com/sssf-code/capacitor-assets/issues"
  },
  "keywords": [
    "ionic",
    "capacitor",
    "resources",
    "mobile",
    "native",
    "icon",
    "splash screen"
  ],
  "dependencies": {
    "@ionic/cli-framework-output": "^2.2.8",
    "@ionic/utils-array": "^2.1.6",
    "@ionic/utils-fs": "^3.1.7",
    "@ionic/utils-subprocess": "^2.1.14",
    "@ionic/utils-terminal": "^2.3.5",
    "@trapezedev/project": "^7.1.9",
    "commander": "^15.0.0",
    "debug": "^4.4.3",
    "fs-extra": "^11.4.0",
    "kleur": "^4.1.5",
    "prompts": "^2.4.2",
    "sharp": "^0.35.3",
    "tslib": "^2.8.1",
    "yargs": "^18.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@changesets/cli": "^2.31.1",
    "@ionic/prettier-config": "^4.0.0",
    "@types/debug": "^4.1.13",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^24.13.3",
    "@types/plist": "^3.0.5",
    "@types/yargs": "^17.0.35",
    "husky": "^9.1.7",
    "oxlint": "^1.78.0",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "tempy": "^3.2.0",
    "typescript": "~5.9.3",
    "vitest": "^4.1.10"
  }
}
